            "text": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Каталог — Библиотека КАИТ</title>\n    <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n</head>\n<body>\n<header class=\"topbar\">\n    <a class=\"logo\" href=\"index.php\">📚 Библиотека КАИТ</a>\n    <nav>\n        <a href=\"index.php?page=catalog\">Каталог</a>\n                    <a href=\"index.php?page=profile\">Мои книги</a>\n                                    <span class=\"user-name\">Тестовый читатель М02</span>\n            <a href=\"index.php?page=logout\" class=\"btn btn-light\">Выйти</a>\n            </nav>\n</header>\n\n<main class=\"container\">\n            <div class=\"alert alert-success\">Добро пожаловать в библиотеку!</div>\n        <h1>Каталог книг</h1>\n\n<form id=\"search-form\" class=\"search\">\n    <input type=\"text\" name=\"q\" id=\"q\" placeholder=\"Название или автор\" maxlength=\"100\">\n    <select name=\"genre\" id=\"genre\">\n        <option value=\"\">Все жанры</option>\n                    <option value=\"2\">Базы данных</option>\n                    <option value=\"6\">Информационная безопасность</option>\n                    <option value=\"4\">Математика</option>\n                    <option value=\"1\">Программирование</option>\n                    <option value=\"3\">Сети</option>\n                    <option value=\"5\">Художественная литература</option>\n            </select>\n    <select name=\"sort\" id=\"sort\">\n        <option value=\"b.title\">По названию</option>\n        <option value=\"b.author\">По автору</option>\n        <option value=\"b.year DESC\">Сначала новые</option>\n    </select>\n    <button type=\"submit\" class=\"btn\">Найти</button>\n</form>\n\n\n<p id=\"found\" class=\"muted\"></p>\n<div id=\"books\" class=\"grid\"></div>\n<div id=\"pager\" class=\"pager\"></div>\n\n</main>\n\n<footer class=\"footer\">\n    © 2026 ГБПОУ КАИТ № 20 · Библиотека\n</footer>\n\n<script>\n    window.APP = {\n        user: {\"id\":7,\"role\":\"reader\",\"name\":\"Тестовый читатель М02\"}    };\n</script>\n<script src=\"assets/js/api.js\"></script>\n<script src=\"assets/js/catalog.js\"></script>\n</body>\n</html>\n\n"
