          "content": {
            "size": 5440,
            "mimeType": "text/css; charset=utf-8",
            "compression": 5707,
            "text": "* { box-sizing: border-box; }\n\nbody {\n    margin: 0;\n    font-family: \"Segoe UI\", Roboto, Arial, sans-serif;\n    font-size: 15px;\n    color: #222;\n    background: #f5f6f8;\n}\n\na { color: #1f5f8b; }\n\n.container {\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 24px 16px 48px;\n    min-height: calc(100vh - 120px);\n}\n\n/* ---------- шапка ---------- */\n.topbar {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 12px 24px;\n    background: #1f5f8b;\n    color: #fff;\n    flex-wrap: wrap;\n}\n.topbar a { color: #fff; text-decoration: none; }\n.topbar nav { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }\n.logo { font-weight: 700; font-size: 18px; }\n.user-name { opacity: .8; font-size: 14px; }\n\n.footer {\n    text-align: center;\n    padding: 16px;\n    color: #888;\n    font-size: 13px;\n}\n\n/* ---------- кнопки и формы ---------- */\n.btn {\n    display: inline-block;\n    padding: 8px 16px;\n    border: 0;\n    border-radius: 6px;\n    background: #2e7bb5;\n    color: #fff !important;\n    cursor: pointer;\n    font-size: 14px;\n    text-decoration: none;\n}\n.btn:hover { background: #24689b; }\n.btn:disabled { opacity: .5; cursor: default; }\n.btn-light { background: #e8eef3; color: #1f5f8b !important; }\n.btn-light:hover { background: #d8e3ec; }\n.btn-small { padding: 4px 10px; font-size: 13px; }\n.btn-wide { width: 100%; }\n\ninput, select, textarea {\n    padding: 8px 10px;\n    border: 1px solid #ccd3da;\n    border-radius: 6px;\n    font: inherit;\n    background: #fff;\n}\nlabel { display: block; margin-bottom: 12px; font-size: 14px; color: #444; }\nlabel input, label select, label textarea { display: block; width: 100%; margin-top: 4px; }\n.field-error { color: #c0392b; font-size: 13px; }\n\n.search { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }\n.search input { flex: 1; min-width: 220px; }\n\n.inline-form { display: flex; gap: 8px; flex-wrap: wrap; }\n.inline-form input { flex: 1; min-width: 200px; }\n\n.form-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0 16px; }\n.span-2 { grid-column: span 2; }\n\n.auth-box {\n    max-width: 420px;\n    margin: 40px auto;\n    background: #fff;\n    padding: 24px 28px;\n    border-radius: 10px;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, .06);\n}\n\n/* ---------- сообщения ---------- */\n.alert { padding: 10px 14px; border-radius: 6px; margin: 12px 0; }\n.alert-success { background: #e6f4ea; color: #1e6b34; }\n.alert-error { background: #fdecea; color: #a12b1f; }\n.muted { color: #888; font-size: 13px; }\n\n/* ---------- каталог ---------- */\n.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }\n.book-card {\n    display: flex;\n    gap: 12px;\n    padding: 12px;\n    background: #fff;\n    border-radius: 10px;\n    text-decoration: none;\n    color: inherit;\n    box-shadow: 0 1px 4px rgba(0, 0, 0, .06);\n    transition: box-shadow .15s;\n}\n.book-card:hover { box-shadow: 0 4px 14px rgba(0, 0, 0, .1); }\n.book-card img, .book-card .cover-placeholder { width: 64px; height: 90px; object-fit: cover; border-radius: 4px; flex-shrink: 0; }\n.book-title { font-weight: 600; margin-bottom: 4px; }\n.cover-placeholder {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #dfe8ef;\n    color: #1f5f8b;\n    font-size: 28px;\n    font-weight: 700;\n}\n.badge { display: inline-block; margin-top: 6px; padding: 2px 8px; border-radius: 10px; font-size: 12px; }\n.badge-ok { background: #e6f4ea; color: #1e6b34; }\n.badge-no { background: #f3e9e9; color: #8a2b2b; }\n.pager { display: flex; gap: 6px; margin-top: 20px; justify-content: center; }\n\n/* ---------- страница книги ---------- */\n.book-page { display: flex; gap: 32px; background: #fff; padding: 24px; border-radius: 10px; }\n.book-cover img, .book-cover .cover-placeholder { width: 180px; height: 260px; object-fit: cover; border-radius: 6px; font-size: 64px; }\n.book-info h1 { margin-top: 0; }\n.author { font-size: 18px; color: #555; }\n.props th { text-align: left; padding: 4px 16px 4px 0; color: #777; font-weight: normal; }\n\n.reviews { margin-top: 24px; }\n.review { background: #fff; padding: 12px 16px; border-radius: 8px; margin-bottom: 10px; }\n.review-head { display: flex; gap: 12px; align-items: baseline; margin-bottom: 6px; }\n.stars { color: #e0a100; letter-spacing: 1px; }\n.review-form { background: #fff; padding: 16px; border-radius: 8px; margin-bottom: 16px; }\n.review-form textarea { width: 100%; margin: 8px 0; }\n\n/* ---------- таблицы ---------- */\n.table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; }\n.table th, .table td { padding: 8px 12px; border-bottom: 1px solid #eef0f2; text-align: left; vertical-align: top; }\n.table th { background: #f0f3f6; font-weight: 600; font-size: 13px; color: #555; }\n.row-late td { background: #fff4f2; }\n\n.card { background: #fff; padding: 16px 20px; border-radius: 10px; margin-bottom: 20px; }\n.stats { display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }\n.stats div { background: #fff; padding: 14px 20px; border-radius: 10px; min-width: 140px; }\n.stats b { display: block; font-size: 26px; color: #1f5f8b; }\n.stats span { color: #888; font-size: 13px; }\n\n@media (max-width: 700px) {\n    .book-page { flex-direction: column; }\n    .form-grid { grid-template-columns: 1fr; }\n    .span-2 { grid-column: auto; }\n}\n\n"
