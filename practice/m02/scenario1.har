            "mimeType": "text/html; charset=UTF-8",
            "compression": 0,
            "text": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>Регистрация — Библиотека КАИТ</title>\n    <link rel=\"stylesheet\" href=\"assets/css/style.css\">\n</head>\n<body>\n<header class=\"topbar\">\n    <a class=\"logo\" href=\"index.php\">📚 Библиотека КАИТ</a>\n    <nav>\n        <a href=\"index.php?page=catalog\">Каталог</a>\n                    <a href=\"index.php?page=login\" class=\"btn btn-light\">Войти</a>\n            <a href=\"index.php?page=register\" class=\"btn\">Регистрация</a>\n            </nav>\n</header>\n\n<main class=\"container\">\n        <div class=\"auth-box\">\n    <h1>Регистрация читателя</h1>\n    <form method=\"post\" action=\"index.php?page=register\" id=\"register-form\">\n        <label>ФИО\n            <input type=\"text\" name=\"full_name\" required maxlength=\"150\" value=\"\">\n                    </label>\n        <label>Email\n            <input type=\"email\" name=\"email\" required maxlength=\"150\" value=\"\">\n                    </label>\n        <label>Пароль (не менее 6 символов)\n            <input type=\"password\" name=\"password\" required minlength=\"6\">\n                    </label>\n        <label>Категория\n            <select name=\"category\">\n                <option value=\"student\">Студент</option>\n                <option value=\"teacher\">Преподаватель</option>\n            </select>\n        </label>\n        <label>Группа (для студентов)\n            <input type=\"text\" name=\"group_name\" maxlength=\"20\" pattern=\"[А-ЯA-Z]{2,5}[0-9]{3}\" placeholder=\"ИСПО332\">\n        </label>\n        <label>Телефон\n            <input type=\"tel\" name=\"phone\" maxlength=\"20\" placeholder=\"+7 900 000-00-00\">\n        </label>\n        <button type=\"submit\" class=\"btn btn-wide\">Зарегистрироваться</button>\n    </form>\n</div>\n\n</main>\n\n<footer class=\"footer\">\n    © 2026 ГБПОУ КАИТ № 20 · Библиотека\n</footer>\n\n<script>\n    window.APP = {\n        user: null    };\n</script>\n<script src=\"assets/js/api.js\"></script>\n</body>\n</html>\n\n"
          },
